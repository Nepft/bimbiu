# Server-only environment variables (NEVER use NUXT_PUBLIC_ for secrets)
NODE_ENV=development

# TiDB / MySQL connection string
# Production TiDB Cloud Serverless example:
# DATABASE_URL=mysql://<user>:<password>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/bimbiu?ssl=true
DATABASE_URL=mysql://user:password@127.0.0.1:4000/bimbiu

# Random 64-char secret for session token HMAC/hashing
SESSION_TOKEN_PEPPER=replace-with-random-64-char-secret

# Public base URL of the app (e.g. https://bimbiu.example.com in production)
APP_BASE_URL=http://localhost:3000

# Google OAuth 2.0 (register GOOGLE_REDIRECT_URI in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
